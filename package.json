{
  "name": "tiny-agents",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run plugins:build && tsc -b && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "bridge": "node server/local.mjs",
    "plugins:build": "node scripts/build-plugins.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "cloud:dev": "wrangler dev --port 8788",
    "cloud:check": "wrangler deploy --dry-run --outdir .local/worker-check-bundle",
    "deploy": "npm run verify && wrangler d1 migrations apply AUTH_DB --remote && wrangler deploy",
    "cloud:test": "node scripts/check-cloud.mjs && node scripts/check-accounts.mjs",
    "verify": "npm run build && npm test && npm run cloud:check && npm run cloud:test"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "better-auth": "1.7.7",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.2",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "wrangler": "4.148.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
